{
  "manifest_version": 3,
  "name": "Gemini Antigravity in Chrome",
  "short_name": "Antigravity",
  "version": "2.1.0",
  "description": "Autonomous browser control, DOM & Shadow DOM inspection, multi-tab synthesis, and live session bridge for Google Antigravity.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Antigravity",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "scripting",
    "debugger",
    "storage",
    "alarms",
    "sidePanel",
    "contextMenus",
    "notifications",
    "nativeMessaging",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/content-script.js"
      ],
      "css": [
        "content/content-style.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "open-side-panel": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Open the Antigravity Side Panel"
    },
    "toggle-pause-control": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Pause or resume Antigravity browser control"
    },
    "pick-page-element": {
      "suggested_key": {
        "default": "Alt+Shift+X"
      },
      "description": "Pick an element on the current page"
    }
  }
}
